<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robust_fast_navigation</name>
  <version>0.0.0</version>
  <description>The robust_fast_navigation package with dual ROS 1/ROS 2 support</description>
  <maintainer email="nm9ur@todo.todo">nm9ur</maintainer>
  <license>TODO</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend> <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">rospy</depend>
  <depend condition="$ROS_VERSION == 1">grid_map_ros</depend>
  <depend condition="$ROS_VERSION == 1">grid_map_core</depend>
  <depend condition="$ROS_VERSION == 1">grid_map_costmap_2d</depend>
  <depend condition="$ROS_VERSION == 1">grid_map_sdf</depend>
  <depend condition="$ROS_VERSION == 1">costmap_2d</depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>

  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">nav2_costmap_2d</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>
  <depend condition="$ROS_VERSION == 2">tf2_ros</depend>
  <depend condition="$ROS_VERSION == 2">grid_map_ros</depend>
  <depend condition="$ROS_VERSION == 2">grid_map_core</depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>